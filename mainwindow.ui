    <property name="styleSheet">
     <string notr="true">/* --- ADD TO CART BUTTON --- */
/* Using the exact object name so it ONLY affects this specific button */
QPushButton#addToCartButton {
    background-color: #FFFFFF;       /* Pure white background */
    color: #28A745;                  /* Crisp, modern green text */
    border: 2px solid #28A745;       /* Matching green border */
    border-radius: 6px;              /* Keeps the modern rounded corners */
    padding: 8px 15px;
    font-weight: bold;
    font-size: 14px;
}

/* Make it invert beautifully when the user hovers their mouse over it! */
QPushButton#addToCartButton:hover {
    background-color: #28A745;       /* Fills in green */
    color: #FFFFFF;                  /* Text turns white */
}</string>
    </property>
    <property name="text">
     <string>Add to Cart</string>
    </property>
