  <property name="styleSheet">
   <string notr="true">/* 1. Make the main background pure white */
QWidget#centralwidget {
    background-color: #FFFFFF;
}

/* 2. Style the Menu and Cart lists */
QListWidget {
    background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    color: #1A1A1D;
    font-size: 14px;
    padding: 5px;
}

QListWidget::item:selected {
    background-color: #FEB47B;
    color: white;
}

/* 3. Style the Buttons */
QPushButton {
    background-color: #FF7E5F;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #E23E57;
}

/* 4. Style the text labels */
QLabel {
    color: #1A1A1D;
    font-weight: bold;
    font-size: 16px;
}</string>
