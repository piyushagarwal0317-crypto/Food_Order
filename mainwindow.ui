    <property name="styleSheet">
     <string notr="true">/* --- CHECKOUT BUTTON --- */
QPushButton#checkoutButton {
    background-color: #28A745;       /* Solid green background */
    color: #FFFFFF;                  /* Pure white text */
    border: none;                    /* No border needed for a solid button */
    border-radius: 6px;              /* Smooth corners */
    padding: 8px 15px;
    font-weight: bold;
    font-size: 14px;
}

/* Make it darken slightly when the user hovers over it */
QPushButton#checkoutButton:hover {
    background-color: #218838;       /* A slightly deeper, richer green */
}</string>
