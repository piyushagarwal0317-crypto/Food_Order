    <property name="styleSheet">
     <string notr="true">/* --- SEARCH BAR STYLING --- */

/* 1. The Search Text Box */
QLineEdit {
    background-color: #F8F9FA;
    border: 2px solid #E0E0E0;
    border-radius: 15px; /* Gives it a nice round pill shape! */
    padding: 6px 15px;
    color: #1A1A1D;
    font-size: 14px;
}

/* Make the border glow Coral when the user clicks to type! */
QLineEdit:focus {
    border: 2px solid #FF7E5F; 
}

/* 2. The Search Button */
/* (Covering both QPushButton and QToolButton just in case!) */
QPushButton#searchButton, QToolButton {
    background-color: #1A1A1D; /* A sleek dark gray to contrast with your Coral buttons */
    color: white;
    border: none;
    border-radius: 15px; /* Match the roundness of the search box */
    padding: 6px 15px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#searchButton:hover, QToolButton:hover {
    background-color: #4A4A4D; /* Lighter gray when hovered */
}</string>
    </property>
