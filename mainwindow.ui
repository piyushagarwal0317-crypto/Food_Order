    <property name="styleSheet">
     <string notr="true">/* --- SLIDING WINDOW / MARQUEE DISPLAY --- */
/* (Change 'scrollingLabel' to whatever your label's exact objectName is!) */
QLabel#specialsLabel {
    background-color: #1A1A1D;       /* A sleek, very dark gray/black background */
    color: #FF7E5F;                  /* Your signature Coral color for the text */
    border: 3px solid #E0E0E0;       /* A thick, modern border to frame it */
    border-radius: 12px;             /* Nice, heavily rounded corners */
    padding: 10px;                   /* Breathing room inside the box */
    font-weight: 900;                /* Extra bold text */
    font-size: 24px;                 /* Much larger text! */
}</string>
    </property>
    <property name="text">
     <string>TextLabel</string>
    </property>
    <property name="alignment">
     <set>Qt::AlignmentFlag::AlignCenter</set>
    </property>
   </widget>
   <widget class="QPushButton" name="addToCartButton">
    <property name="geometry">
     <rect>
      <x>70</x>
      <y>480</y>
      <width>211</width>
      <height>41</height>
