    <property name="styleSheet">
     <string notr="true">/* Style the Drop-Down Menu so it isn't invisible! */
QComboBox {
    background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 5px 10px;
    color: #1A1A1D;
    font-size: 14px;
    font-weight: bold;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}</string>
